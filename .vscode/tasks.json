{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Active LaTeX File",
            "type": "shell",
            "command": "PowerShell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/build_latex.ps1",
                "-texFile",
                "${fileBasename}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}


