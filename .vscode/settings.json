{
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-build-pdf",
            "command": "PowerShell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "%WORKSPACE_FOLDER%/build_latex.ps1",
                "-texFile",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk-build-pdf",
            "tools": [
                "latexmk-build-pdf"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "latexmk-build-pdf"
}
